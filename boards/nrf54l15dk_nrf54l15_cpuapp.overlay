#include <zephyr/dt-bindings/sensor/lsm6dso.h>

&mx25r64 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		spi_flash_test_partition: partition@7ff000 {
			label = "spi-flash-test";
			reg = <0x7ff000 0x1000>;
		};
	};
};

&spi21 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi21_default>;
	pinctrl-1 = <&spi21_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio1 8 GPIO_ACTIVE_LOW>;

	lsm6dso: lsm6dso@0 {
		compatible = "st,lsm6dso";
		reg = <0>;
		spi-max-frequency = <1000000>;
		accel-range = <LSM6DSO_DT_FS_2G>;
		accel-odr = <LSM6DSO_DT_ODR_104Hz>;
		gyro-range = <LSM6DSO_DT_FS_250DPS>;
		gyro-odr = <LSM6DSO_DT_ODR_104Hz>;
		status = "okay";
	};
};

&pinctrl {
	spi21_default: spi21_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 11)>,
				<NRF_PSEL(SPIM_MOSI, 1, 13)>,
				<NRF_PSEL(SPIM_MISO, 1, 14)>;
		};
	};

	spi21_sleep: spi21_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 11)>,
				<NRF_PSEL(SPIM_MOSI, 1, 13)>,
				<NRF_PSEL(SPIM_MISO, 1, 14)>;
			low-power-enable;
		};
	};
};
